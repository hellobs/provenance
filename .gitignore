# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/

.claude/
checkpoints/

# 数据归类搬迁(2026-10-08):所有"跑出来的存档"统一放仓根 `data/`。
# 见 `provenance/docs/仓库布局说明.md`;搬迁期新旧位置并存,读侧由
# `case_engine.paths.data_root()` 决定(新位置优先、老位置回落并出声)。
# 整棵不入库:里面有 311+ 条成品记录、case00 的 2.4 GB 沙盒存档与跨局登记簿。
data/

# 临时测试脚本与工具
_tmp_test/

# 新生成的模拟回放数据（注意:中间带分隔符的规则锚定在 .gitignore 所在目录(仓库根),
# 必须写 provenance/ 前缀 —— 原来的 `results/compressed/` 匹配不到
# provenance/results/compressed/,规则形同虚设,2026-09-27 体检修正）
provenance/results/compressed/*
# 内置样例已追踪:用白名单保住(git 规则:父目录被整体排除就无法重新包含,
# 故上面必须用 `/*`(排除内容)而非 `目录/`,否则这两条白名单不生效)
!provenance/results/compressed/example/
!provenance/results/compressed/invest-room/

# Tiled 编辑器工作文件(tilemap.json/.tmx 是运行时与编辑底图,已入库;其余为中间产物)
provenance/frontend/static/assets/village/tilemap/*.bak*
provenance/frontend/static/assets/village/tilemap/_debug_err.txt
provenance/frontend/static/assets/village/tilemap/finance_extras.jpg
# tilemap_to_maze 工具自动导出的中间产物(等价于 tilemap.json,不入库)
provenance/frontend/static/assets/village/tilemap/*.exported.json

# 决策导出产物(由 checkpoints 生成,不入库)
decisions_*.json

# 前端冒烟测试渲染产物(pytest 生成,CI 用,不入库)
tests/_pages/

# 本地服务日志与 pid 文件(tools/serve_all.py 的产物:运行态,不入库)
# *.log 早已忽略,这条是为了 `logs/serve/pids.json` 之类非 .log 文件也不弄脏工作区。
logs/

# Python 打包产物(uv build / setuptools)
dist/
build/
*.egg-info/
.venv/
# 仓内工具按这个名字找解释器(见 tools/setup_all.py 与 run_live_watchdog.ps1);
# 用 `.venv*` 兜住 `setup_all.py --venv-name` 选的自定义名,免得建完弄脏工作区。
.venv*/
.uv/

# 目视验收截图(用 case01/tools/webshot.js 随时重新生成,不入库)
.shots/
provenance/.shots/

# case01 运行记录/样本一律不入库(约定:只入约定与代码,不入记录)。
# 2026-09-19:用新目录名 runs_archive_* 归档时漏了这条,把 11 条记录提交进了公开仓库。
provenance/case01/runs_archive_*/

# 换场景时 install_scene.py 留下的就地备份(旧版本在 git 历史里,不必入库)
provenance/case*/scenario/maze.json.*.bak
provenance/frontend/static/assets/village/tilemap/tilemap.*.bak.json
# 修正:case01 的 maze 在 injector/scenario 下(比 case00 多一层),上面的规则没盖到
provenance/case*/*/scenario/maze.json.*.bak
provenance/case*/scenario/maze.json.*.bak
# Tiled 另存的"副本"文件不入库
* - 副本.tmx
# --fix-spawns 挪坐标时留下的 agent.json 备份(旧值在 git 历史里)
provenance/case*/**/agents/*/agent.json.*.bak
provenance/case*/agents/*/agent.json.*.bak
# 角色目录**整体**备份(如 install_scene --remap 留下的 agents.remap-<ts>.bak/,
# 含 agent.json 与贴图;旧版本在 git 历史里,不必入库)
provenance/case*/scenario/*.bak/
# 前端 village 根下 maze 的就地备份(此前只盖了 case*/scenario 与 tilemap,漏了这处)
provenance/frontend/static/assets/village/maze.json.bak*

# 审计/共享临时目录(工作区里有,但不入库)
.audit-tmp/
.trae-html-share-packages/

# workbuddy 记忆目录(2026-10-03 补):它已被 doc_audit.py / test_docs_status.py
# 的 SKIP_DIRS 跳过,但漏了 gitignore,于是每次 `git status` 都冒出来。
# 记忆文件是本机工作状态,不是项目约定,不入库。
.workbuddy/
# Trae IDE 的工作区(2026-10-07 补,与上一条同理由):别人在这台机器上用 Trae 时
# 落在 ../.trae/ 的 plans/skills/documents 是 IDE 工作状态,不是本仓文档。
# 它已进 doc_audit.py 的 SKIP_DIRS;这里补 gitignore,免得 `git add .` 吃进来。
.trae/
